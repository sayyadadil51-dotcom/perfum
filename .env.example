# ── ScrapKart environment ────────────────────────────────────────────────
# Everything below is OPTIONAL. With no env vars the app runs on its built-in
# demo backend (localStorage) and is fully clickable end-to-end.

# Supabase (Auth + Postgres + Storage + Realtime)
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql then supabase/seed.sql in the SQL editor
# 3. Copy the project URL + anon key here
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay (payments). Test key starts with rzp_test_
VITE_RAZORPAY_KEY_ID=
